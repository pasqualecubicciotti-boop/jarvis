# Copia questo file in ".env" e sostituisci i valori. NON caricare mai ".env" su GitHub.

# Token del bot: lo ottieni scrivendo a @BotFather su Telegram
TELEGRAM_BOT_TOKEN=incolla-qui-il-token-di-botfather

# Il tuo ID numerico Telegram: lo ottieni scrivendo a @userinfobot
TELEGRAM_OWNER_ID=123456789

# Chiave API di Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=incolla-qui-la-chiave-anthropic

# --- Opzionali (i valori qui sotto sono quelli predefiniti) ---

# Modello: claude-haiku-5-5 (economico), claude-sonnet-5-5 (piu' capace), claude-opus-5-5 (il migliore, costa di piu')
JARVIS_MODEL=claude-haiku-5-5

# Lunghezza massima di ogni risposta (in "token", circa 3/4 di parola ciascuno)
JARVIS_MAX_TOKENS=1024

# Quanto "ragiona" il modello: low (veloce, economico), medium, high
JARVIS_EFFORT=low

# Massimo di chiamate al modello al giorno (protegge il tuo portafoglio)
JARVIS_DAILY_LIMIT=100

# Fuso orario per data e ora
JARVIS_TIMEZONE=Europe/Rome

# Cartella dove vengono salvati promemoria, contatori e registro
JARVIS_DATA_DIR=data
